<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Watchlist.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" />

    <!--
      Coverage is a reading this suite owes rather than a number it gates on. The
      collector is asked for it by name, by the collect switch on the test command, so
      a run that does not ask pays nothing and no check here fails on a number.
    -->
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    The plugin project excludes the runtime assets of these two packages, because a
    plugin is loaded next to a server that already carries them. A test process has
    no server around it, so the same assemblies are referenced here with their
    runtime assets kept, and the versions have to match the plugin's by hand until
    one place holds them.
  -->
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.9.11" />
    <PackageReference Include="Jellyfin.Model" Version="10.9.11" />
  </ItemGroup>

  <!--
    HEADLESS.md is compiled into the test assembly so a test can read it. Issues on
    this board point at that file instead of repeating the rule in it, and an
    embedded copy means the file cannot be deleted or renamed without a red suite.
  -->
  <ItemGroup>
    <EmbeddedResource Include="HEADLESS.md" />
    <EmbeddedResource Include="HeadlessRules.txt" />
    <EmbeddedResource Include="HEADLESS-EXCEPTIONS.txt" />
  </ItemGroup>

  <!--
    The headless guard reads the suite's own sources. They are embedded by a
    wildcard rather than listed, so a file added tomorrow is scanned the moment it
    is added and nobody has to remember a list. The fixtures the guard is proven
    against are .txt on purpose: they hold the calls the guard refuses, so they
    must not be compiled and must not be scanned as sources.

    A fixture file name carries one extension and no more. A second extension is
    read as a culture by the build, so a file called Something.cs.txt goes into a
    Czech satellite assembly and is missing from the manifest at run time.
  -->
  <ItemGroup>
    <EmbeddedResource Include="**\*.cs" Exclude="bin\**;obj\**">
      <LogicalName>testsource/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Fixtures\*.json">
      <LogicalName>fixture/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Fixtures\*.txt">
      <LogicalName>fixture/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    build.yaml is embedded into the test assembly rather than located on disk at run
    time, so the identity test reads this tree's manifest and never a copy that
    happens to sit beside the test host. The build refreshes it on every run.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\build.yaml" LogicalName="build.yaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jellyfin.Plugin.Watchlist\Jellyfin.Plugin.Watchlist.csproj" />
  </ItemGroup>

</Project>
